# Copy this file to .env and paste your key after the = sign (no quotes, no spaces).
# Get a key at console.anthropic.com -> API Keys. Set a monthly spend limit while you're there!
#
# This is deliberately NOT named ANTHROPIC_API_KEY. If it were, Claude Code would
# bill this key instead of your Claude subscription.
AIRESCENTS_ANTHROPIC_KEY=

# Optional: which Claude model the app uses.
AIRESCENTS_MODEL=claude-sonnet-5-5
